# FailSafe environment template. Copy to .env and adjust. Never commit .env.
# The demo runs fully offline with zero external keys.

# SQLite database (local, zero-credential)
DATABASE_URL="file:./dev.db"

# Deterministic demo mode and injected clock
DEMO_MODE=true
DEMO_NOW=2026-11-17T16:00:00Z
ADMIN_TOKEN=
# Set to true ONLY behind a reverse proxy that overwrites X-Forwarded-Host; otherwise write
# routes compare the browser Origin against the Host header alone (CSRF check).
TRUST_PROXY=

# Optional read-only Ramp sandbox adapter (FS-18). Leave blank for the demo: Ramp status reports
# NOT_CONFIGURED and POST /api/integrations/ramp/sync returns 503 without any network call.
# Syncing requires an empty RAMP_SANDBOX workspace (`pnpm ramp:init --confirm`, which clears the DB).
# Scopes requested: transactions:read cards:read funds:read. Live sandbox sync is untested (no credentials).
# FailSafe never calls Ramp write endpoints and never requests card PAN/CVV.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Only the sandbox is supported in this MVP; any other value (including production) is NOT_CONFIGURED.
RAMP_API_BASE_URL=https://demo-api.ramp.com

# Optional: AI-assisted dependency suggestions (FS-19) for manifest imports (suggester "ai").
# Blank LLM_API_KEY or LLM_MODEL = "AI OFF": rules-based suggestions only, nothing faked.
# An OpenAI-style chat-completions endpoint (tested with mocked responses only; the server must
# support JSON mode via response_format). LLM_BASE_URL defaults to https://api.openai.com/v1
# (https only, or http on localhost). Only references matching the built-in provider list are sent
# (versions only when plain semver-like), never files or secrets. The model may only explain
# mappings the taxonomy supports, and every AI suggestion stays SUGGESTED until a person reviews it.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
